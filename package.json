{
  "name": "vehicle-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "JD's Towing \u2013 Vehicle Maintenance Tracker (offline PWA + Capacitor Android wrapper)",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "vendor": "node scripts/vendor.js",
    "serve": "python3 -m http.server 8080 --directory www",
    "icons": "python3 scripts/make_icons.py",
    "test:xlsx": "python3 tests/verify_xlsx.py",
    "test:e2e": "node tests-e2e/e2e.js",
    "test:all": "npm test && npm run test:xlsx && npm run test:e2e",
    "android:release": "./scripts/build-apk.sh release",
    "android:debug": "./scripts/build-apk.sh debug"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "exceljs": "^4.4.0"
  }
}
